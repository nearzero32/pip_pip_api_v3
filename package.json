{
  "name": "pip_pip_api_v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "bun build src/index.ts src/db/migrate.ts --outdir dist --target bun --minify",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/db/migrate.ts",
    "db:migrate:prod": "bun dist/db/migrate.js",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@elysiajs/openapi": "1.4.15",
    "drizzle-orm": "0.45.2",
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "0.31.10",
    "typescript": "7.0.2"
  }
}
