# Development placeholders only. Replace every value outside local development.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://pip_pip_dev:pip_pip_dev_only@localhost:5433/pip_pip_v3
# Integration tests create and drop only randomly named pip_pip_v3_test_* databases through this local admin connection.
TEST_ADMIN_DATABASE_URL=postgresql://pip_pip_dev:pip_pip_dev_only@localhost:5433/pip_pip_v3
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
REDIS_URL=redis://localhost:6380
OTP_DELIVERY_ADAPTER=development
SECRET_VERIFIER_KEY=development-only-verifier-key-change-me-32chars
SECRET_VERIFIER_KEY_VERSION=v1
JWT_ISSUER=pip-pip-api-v3-development
JWT_KEY_ID=dev-ed25519-v1
JWT_PRIVATE_KEY_BASE64=MC4CAQAwBQYDK2VwBCIEIOhYjslG5wawzghWHcQbYCMjFp8kzMYLVFZoKEOBzTA4
JWT_PUBLIC_KEY_BASE64=MCowBQYDK2VwAyEA+ly2CeP4N1AQ5vNUEt226L6GtOMU/uLE2rjFfo4OBCE=
ACCESS_TOKEN_LIFETIME_SECONDS=600
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1

# Cloudflare R2 (S3-compatible). Never commit real credentials.
R2_ENDPOINT=https://00000000000000000000000000000000.r2.cloudflarestorage.com
R2_BUCKET=pip-pip-media-dev
R2_ACCESS_KEY_ID=development-r2-access-key-id
R2_SECRET_ACCESS_KEY=development-r2-secret-access-key-change-me
R2_PUBLIC_BASE_URL=https://media-dev.example.com
R2_UPLOAD_URL_TTL_SECONDS=300
MEDIA_MAX_IMAGE_BYTES=5242880
MEDIA_UNATTACHED_TTL_HOURS=24
MEDIA_CLEANUP_INTERVAL_SECONDS=900
MEDIA_DELETE_LEASE_SECONDS=300
# Prepared external OSRM server; no dataset-less OSRM container is bundled.
OSRM_BASE_URL=http://host.docker.internal:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=3000
DELIVERY_PRICING_CACHE_TTL_SECONDS=21600

# Dashboard Excel export: refuse rather than silently truncate when the filter matches more rows
DASHBOARD_EXPORT_MAX_ROWS=10000

# M4-B driver offer rate limits and runtime knobs (distributed via Redis in production)
DRIVER_OFFER_SPIN_LIMIT=30
DRIVER_OFFER_SPIN_WINDOW=60
DRIVER_OFFER_CLAIM_LIMIT=20
DRIVER_OFFER_CLAIM_WINDOW=60
DASHBOARD_MANUAL_ASSIGN_LIMIT=30
DASHBOARD_MANUAL_ASSIGN_WINDOW=60
DRIVER_OFFER_SPIN_AGE_BUCKET_MS=60000
DRIVER_OFFER_SPIN_ROTATION_WINDOW_MS=15000
DRIVER_RUNTIME_HYDRATE_LOCK_TTL_SECONDS=8
DRIVER_RUNTIME_HYDRATE_WAIT_MS=2000
DRIVER_RUNTIME_HYDRATE_POLL_MS=50
DRIVER_LOCATION_FRESH_SECONDS=120
DRIVER_RUNTIME_DEGRADED_TTL_MS=2000
DRIVER_RUNTIME_DEGRADED_MAX_ENTRIES=2000
DRIVER_RUNTIME_HYDRATE_ADVISORY_LOCK_TIMEOUT_MS=2000
REDIS_RECON_ENABLED=true
REDIS_RECON_POLL_INTERVAL_MS=2000
REDIS_RECON_BATCH_SIZE=25
REDIS_RECON_MAX_ATTEMPTS=12
REDIS_RECON_RETRY_BASE_MS=1000
REDIS_RECON_RETRY_MAX_MS=60000
REDIS_RECON_LEASE_SECONDS=30
REDIS_RECON_RETENTION_DAYS=7
